<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <permission android:name="io.github.yudigaga.taplusbridge.CANCEL_CAPTURE" android:protectionLevel="signature" />
    <uses-permission android:name="io.github.yudigaga.taplusbridge.CANCEL_CAPTURE" />
    <!-- The rule editor selects any installed or frozen application, including custom source apps. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <queries>
        <package android:name="com.miui.contentextension" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
    <application android:name=".runtime.BridgeApplication" android:label="@string/app_name" android:theme="@style/AppTheme"
        android:allowBackup="false" android:supportsRtl="true" android:icon="@drawable/ic_portal">
        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.TransitActivity" android:exported="true"
            android:theme="@style/TransitTheme" android:excludeFromRecents="true" />
        <activity android:name=".drag.DragActivity" android:exported="false"
            android:theme="@style/DragTheme" android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.drag" />
        <provider android:name=".drag.DragShareProvider" android:authorities="${applicationId}.drag.images"
            android:exported="false" android:grantUriPermissions="true" />
        <service android:name=".lens.LensService" android:exported="true" android:process=":lens" />
        <activity android:name=".lens.LensInteractionActivity" android:exported="false"
            android:process=":lens" android:excludeFromRecents="true" />
        <provider android:name=".lens.LensImageProvider" android:authorities="${applicationId}.lens.images"
            android:exported="false" android:grantUriPermissions="true" android:process=":lens" />
        <provider android:name=".bridge.BridgeProvider"
            android:authorities="io.github.yudigaga.taplusbridge.bridge" android:exported="true" />
        <provider android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku" android:multiprocess="false"
            android:enabled="true" android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
